# Este é um repo de EXEMPLO: as sete skills do fluxo (ask, blueprintfy,
# context-repo-bootstrap, pm-create-pb, pm-create-prd, prd-to-adr, graphify) são
# versionadas de propósito em .claude/skills/, para quem clonar ver o fluxo inteiro
# sem precisar instalar nada primeiro — ver README, seção "Ferramentas".
# Num context-repo de produto real a prática recomendada é a oposta (não
# versionar, instalar do catálogo/do skill marketplace) — a exceção é só para
# este repo. evals/ (fixtures de teste da própria skill), caches e o marcador de
# versão do install global (.graphify_version) ficam de fora mesmo assim.
.claude/skills/*
!.claude/skills/ask/
!.claude/skills/blueprintfy/
!.claude/skills/context-repo-bootstrap/
!.claude/skills/pm-create-pb/
!.claude/skills/pm-create-prd/
!.claude/skills/prd-to-adr/
!.claude/skills/graphify/
.claude/skills/*/evals/
.claude/skills/*/**/__pycache__/
.claude/skills/*/**/*.pyc
.claude/skills/graphify/.graphify_version

# Skills de outras plataformas agênticas / de terceiros, fora do fluxo deste
# repo — nunca versionadas.
.agents/skills/

# Instalador de skills de terceiros (o pacote adhd-agent traz adhd/grill-me).
# Ferramenta de quem está trabalhando, não dependência deste repositório —
# os scripts daqui são stdlib-only e não usam node.
node_modules/
package.json
package-lock.json
skills-lock.json

# Grafos temporários do /graphify, criados sob demanda pela skill ask. Descartáveis.
.graphs/

# Clones rasos dos repositórios técnicos, usados quando o `local` do doc de
# componente não existe nesta máquina. Descartáveis.
.repo-cache/

__pycache__/
*.pyc
